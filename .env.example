# Entorno: development, production o test.
ENVIRONMENT=production
DEBUG=0
SECRET_KEY=reemplazar-por-una-clave-larga-y-unica
ALLOWED_HOSTS=127.0.0.1,imagenes.siwih.local

# MySQL de SIWIH Images.
DB_DEFAULT_NAME=siwi_image
DB_DEFAULT_USER=siwi_images
DB_DEFAULT_PASSWORD=reemplazar
DB_DEFAULT_HOST=127.0.0.1
DB_DEFAULT_PORT=3306
DB_CONN_MAX_AGE=60

# Directorios persistentes, fuera del repositorio.
MEDIA_ROOT=/data/media/images
STATIC_ROOT=/var/lib/siwi-images/staticfiles
LOG_DIR=/var/log/siwi-images
LOG_LEVEL=INFO

# Produccion debe terminar HTTPS en Nginx. Usar 0 solamente si Seguridad
# aprueba una red privada dedicada donde no sea posible interceptar el JWT.
USE_HTTPS=1
SECURE_HSTS_SECONDS=31536000
